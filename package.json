{
  "name": "hello-tagbilaran",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "postcss": "8.5.10"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run content:validate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "content:validate": "tsx scripts/validate-content.ts",
    "images:optimize": "node scripts/optimize-images.mjs",
    "map:buildings": "node scripts/build-tagbilaran-buildings.mjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "validate": "npm run lint && npm run typecheck && npm run content:validate && npm run test:unit && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.0",
    "maplibre-gl": "^5.24.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "geojson-vt": "^4.0.3",
    "jsdom": "^29.1.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "vt-pbf": "^3.1.3"
  }
}
